{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frf.example/schemas/etp/etp-claim.v1.schema.json",
  "title": "FRF ETP generalized claim v1",
  "description": "Twenty required coordinates identify a claim. Ten separate status dimensions record distinct facts. A single confidence score or assurance level is forbidden. A retained contradictory native observation cannot be erased by a positive proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spec",
    "id",
    "property",
    "interpretation",
    "quantification",
    "legal_domain",
    "threat_model",
    "leakage_model",
    "subject_identity",
    "source_identity",
    "build_identity",
    "artifact_identity",
    "runtime_environment",
    "deployment_scope",
    "semantic_model",
    "assumptions",
    "trusted_computing_base",
    "obligations",
    "supporting_evidence",
    "contradictory_evidence",
    "policy_identity",
    "invalidation_dependencies",
    "status_dimensions"
  ],
  "properties": {
    "schema": {"const": "frf-etp.claim.v1"},
    "spec": {"const": "frf-etp-v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 4096},
    "property": {
      "enum": [
        "model_clear",
        "model_parity",
        "binary_compatible",
        "functionally_compatible",
        "reproducible_build",
        "claim_integrity",
        "process_conformance",
        "interoperability",
        "memory_safety",
        "constant_time",
        "cryptographic_correctness",
        "deployment_security",
        "sound_safe_interior",
        "safe_compatible"
      ]
    },
    "interpretation": {"type": "string", "minLength": 1, "maxLength": 4096},
    "quantification": {
      "enum": [
        "finite_observation",
        "finite_model_exhaustion",
        "bounded_model",
        "universal_contextual",
        "deployment_restricted"
      ]
    },
    "legal_domain": {
      "enum": [
        "finite_observation",
        "finite_model_exhaustion",
        "bounded_model",
        "universal_contextual",
        "deployment_restricted"
      ]
    },
    "threat_model": {"type": "string", "minLength": 1, "maxLength": 4096},
    "leakage_model": {"type": "string", "minLength": 1, "maxLength": 4096},
    "subject_identity": {"type": "string", "minLength": 1, "maxLength": 4096},
    "source_identity": {"type": "string", "minLength": 1, "maxLength": 4096},
    "build_identity": {"type": "string", "minLength": 1, "maxLength": 4096},
    "artifact_identity": {"type": "string", "minLength": 1, "maxLength": 4096},
    "runtime_environment": {"type": "string", "minLength": 1, "maxLength": 4096},
    "deployment_scope": {"type": "string", "minLength": 1, "maxLength": 4096},
    "semantic_model": {"type": "string", "minLength": 1, "maxLength": 4096},
    "assumptions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "state"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 4096},
          "statement": {"type": "string", "minLength": 1, "maxLength": 4096},
          "state": {
            "enum": [
              "discharged",
              "declared",
              "unknown",
              "refuted",
              "not_applicable_with_evidence"
            ]
          }
        }
      }
    },
    "trusted_computing_base": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "obligations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "supporting_evidence": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "digest", "location"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 4096},
          "kind": {
            "enum": [
              "digest_bound_artifact",
              "executed_receipt",
              "proof_object",
              "observation_record",
              "review_record",
              "external_provider_object",
              "policy_document"
            ]
          },
          "digest": {"type": "string", "minLength": 1, "maxLength": 4096},
          "location": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    "contradictory_evidence": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "statement", "source", "retained", "resolution"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 4096},
          "class": {
            "enum": [
              "native_observation",
              "model_observation",
              "proof_counterexample",
              "review_finding",
              "external_observation"
            ]
          },
          "statement": {"type": "string", "minLength": 1, "maxLength": 4096},
          "source": {"type": "string", "minLength": 1, "maxLength": 4096},
          "retained": {"const": true},
          "resolution": {
            "enum": ["unresolved", "explained", "resolved_by_new_evidence"]
          }
        }
      }
    },
    "policy_identity": {"type": "string", "minLength": 1, "maxLength": 4096},
    "invalidation_dependencies": {
      "type": "array",
      "maxItems": 256,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "status_dimensions": {
      "$ref": "etp-status-dimensions.v1.schema.json"
    }
  }
}
