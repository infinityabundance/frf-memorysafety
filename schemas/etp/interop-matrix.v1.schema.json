{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frf.example/schemas/etp/interop-matrix.v1.schema.json",
  "title": "ETP Interop Matrix Model v1",
  "description": "Four-way interop matrix for the length-prefixed TCP protocol fixture (interop.c). Records per-cell outcomes, per-process identity, case population, common failures, candidate-specific failures, environment, and fixture identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spec",
    "accepted",
    "claim_ceiling",
    "environment",
    "fixture",
    "binaries",
    "cells",
    "summary",
    "refusal_code",
    "refusal_detail"
  ],
  "properties": {
    "schema": { "type": "string", "const": "frf-etp.interop-matrix.v1" },
    "spec": { "type": "string", "const": "frf-etp-interop-matrix-v1" },
    "accepted": { "type": "boolean" },
    "claim_ceiling": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcc_version", "ld_version", "python_version", "hostname"],
      "properties": {
        "gcc_version": { "type": "string" },
        "ld_version": { "type": "string" },
        "python_version": { "type": "string" },
        "hostname": { "type": "string" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_sha256", "cases"],
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "cases": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "binaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "candidate"],
      "properties": {
        "reference": { "$ref": "#/$defs/binary" },
        "candidate": { "$ref": "#/$defs/binary" }
      }
    },
    "cells": {
      "type": "array",
      "items": { "$ref": "#/$defs/cell" },
      "minItems": 24,
      "maxItems": 24
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_cases", "total_cells", "common_failures", "candidate_specific_failures"],
      "properties": {
        "total_cases": { "type": "integer", "minimum": 0 },
        "total_cells": { "type": "integer", "minimum": 0 },
        "common_failures": { "type": "array", "items": { "type": "string" } },
        "candidate_specific_failures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "refusal_code": {
      "type": ["string", "null"],
      "enum": [
        null,
        "not_run",
        "unresolved",
        "wrong_endpoint",
        "wrong_executable",
        "stale_fixture",
        "missing_cell",
        "missing_case",
        "duplicate_case",
        "substituted_dso"
      ]
    },
    "refusal_detail": { "type": "string" }
  },
  "$defs": {
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "binary_sha256", "gcc_version", "ld_version", "compile_command"],
      "properties": {
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "binary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "gcc_version": { "type": "string" },
        "ld_version": { "type": "string" },
        "compile_command": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 3
        }
      }
    },
    "proc_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exe_path", "exe_digest", "dsos", "loader_closure_digest"],
      "properties": {
        "exe_path": { "type": ["string", "null"] },
        "exe_digest": { "type": "string" },
        "dsos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string" }
            }
          }
        },
        "loader_closure_digest": { "type": "string" }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_variant",
        "server_variant",
        "case",
        "client_binary_sha256",
        "server_binary_sha256",
        "client_identity",
        "server_identity",
        "client_proc_identity",
        "server_proc_identity",
        "client_result_line",
        "server_done",
        "client_returncode",
        "outcome"
      ],
      "properties": {
        "client_variant": { "type": "string", "enum": ["reference", "candidate"] },
        "server_variant": { "type": "string", "enum": ["reference", "candidate"] },
        "case": { "type": "string" },
        "client_binary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "server_binary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "client_identity": { "type": "object" },
        "server_identity": { "type": "object" },
        "client_proc_identity": { "$ref": "#/$defs/proc_identity" },
        "server_proc_identity": { "$ref": "#/$defs/proc_identity" },
        "client_result_line": { "type": "string" },
        "server_done": { "type": "string" },
        "client_returncode": { "type": "integer" },
        "outcome": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "reject",
            "not_run",
            "unresolved",
            "wrong_endpoint",
            "wrong_executable",
            "stale_fixture",
            "missing_cell",
            "missing_case",
            "duplicate_case",
            "substituted_dso"
          ]
        }
      }
    }
  }
}
