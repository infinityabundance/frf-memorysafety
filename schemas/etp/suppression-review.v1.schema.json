    },
    "suppression_id": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "result_id": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "justification": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "scope": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "owner": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "reviewer_identity": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
