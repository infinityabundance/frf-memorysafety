{
  "$defs": {
    "count": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "count"
      ],
      "type": "object"
    },
    "digest": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "name"
      ],
      "type": "object"
    },
    "date-time": {
      "additionalProperties": false,
      "properties": {
        "type": "string",
        "format": "date-time"
      },
      "required": [
        "type"
      ],
      "default": "2026-01-01T00:00:00Z"
    },
    "email": {
      "additionalProperties": false,
      "properties": {
        "type": "string",
        "format": "email"
      },
      "required": [
        "type"
      ],
      "default": "test@example.com"
    },
    "integer": {
      "additionalProperties": false,
      "properties": {
        "type": "integer"
      },
      "required": [
        "type"
      ],
      "default": 0
    },
    "string": {
      "additionalProperties": false,
      "properties": {
        "type": "string",
        "maxLength": 8192
      },
      "required": [
        "type"
      ],
      "default": ""
    }
  },
