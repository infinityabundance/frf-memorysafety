{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frf.example/schemas/etp/timing-profile.v1.schema.json",
  "title": "ETP Timing Profile Model v1",
  "description": "Model describing an ETP bounded live timing/execution-path profile for a single fixture under valgrind callgrind measurement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim",
    "property",
    "level",
    "threat_model",
    "leakage_model",
    "quantification",
    "assumptions",
    "claim_ceiling"
  ],
  "properties": {
    "claim": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "property": {
          "type": "string",
          "enum": [
            "secret_dependent_branch",
            "constant_time",
            "representation_length"
          ]
        },
        "level": { "type": "string", "enum": ["source", "binary"] },
        "threat_model": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "leakage_model": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "quantification": {
          "type": "string",
          "enum": ["finite_observation", "finite_model_exhaustion", "bounded_model", "universal_contextual"]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "state"],
            "properties": {
              "id": { "type": "string" },
              "statement": { "type": "string" },
              "state": {
                "type": "string",
                "enum": ["discharged", "declared", "unknown", "refuted", "not_applicable_with_evidence"]
              }
            }
          }
        },
        "claim_ceiling": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "class": {
            "type": "string",
            "enum": ["public", "secret", "declassified", "derived_public", "derived_secret", "unknown"]
          },
          "representation_class": {
            "type": "string",
            "enum": ["fixed_width", "variable_length", "normalized", "serialized", "spare_capacity", "uninitialized"]
          },
          "length_class": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "class": {
            "type": "string",
            "enum": ["fixed_width", "variable_length", "normalized", "serialized", "spare_capacity", "uninitialized"]
          },
          "observable_flag": {
            "type": "string",
            "enum": ["lengths", "capacity", "allocation_sizes", "object_shape", "pointer_derived_access", "control_flow", "algorithm_selection", "failure_behaviour"]
          }
        }
      },
      "additionalProperties": false
    },
    "trace_model": {
      "type": "object",
      "properties": {
        "observables_in_scope": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 10
        },
        "explicit_exclusions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0
        },
        "limitations": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "fixed_iteration_count": { "type": "boolean" },
        "no_leakage_detected": { "type": "boolean" },
        "source_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "binary_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
        "gcc_version": { "type": "string" },
        "ld_version": { "type": "string" },
        "valgrind_version": { "type": "string" },
        "callgrind_annotate_version": { "type": "string" },
        "objdump_version": { "type": "string" },
        "compile_command": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 5,
          "maxItems": 5
        },
        "callgrind_command": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 5,
          "maxItems": 5
        },
        "ct_no_conditional_branch": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}