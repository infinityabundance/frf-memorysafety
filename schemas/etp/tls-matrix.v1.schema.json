{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frf.example/schemas/etp/tls-matrix.v1.schema.json",
  "title": "ETP TLS Matrix Model v1",
  "description": "Four-way TLS echo matrix for Phase 13.2. Records per-cell outcomes, per-process identity, case population, common failures, candidate-specific failures, environment, and fixture identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "spec", "accepted", "claim_ceiling",
    "environment", "fixture", "binaries", "cells", "summary",
    "refusal_code", "refusal_detail"
  ],
  "properties": {
    "schema": { "type": "string", "const": "frf-etp.tls-matrix.v1" },
    "spec": { "type": "string", "const": "frf-etp-tls-matrix-v1" },
    "accepted": { "type": "boolean" },
    "claim_ceiling": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gcc_version", "ld_version", "python_version", "hostname", "openssl_version"],
      "properties": {
        "gcc_version": { "type": "string" },
        "ld_version": { "type": "string" },
        "python_version": { "type": "string" },
        "hostname": { "type": "string" },
        "openssl_version": { "type": "string" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_source_path", "server_source_sha256", "client_source_path", "client_source_sha256", "cases"],
      "properties": {
        "server_source_path": { "type": "string", "minLength": 1 },
        "server_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "client_source_path": { "type": "string", "minLength": 1 },
        "client_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "cases": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "binaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "candidate"],
      "properties": {
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["server_source_sha256", "client_source_sha256", "server_binary_sha256", "client_binary_sha256", "gcc_version", "ld_version", "server_compile_command", "client_compile_command"],
          "properties": {
            "server_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "client_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "server_binary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "client_binary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "gcc_version": { "type": "string" },
            "ld_version": { "type": "string" },
            "server_compile_command": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 3
            },
            "client_compile_command": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 3
            }
          }
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["server_source_sha256", "client_source_sha256", "server_binary_sha256", "client_binary_sha256", "gcc_version", "ld_version", "server_compile_command", "client_compile_command"],
          "properties": {
            "server_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "client_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "server_binary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "client_binary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "gcc_version": { "type": "string" },
            "ld_version": { "type": "string" },
            "server_compile_command": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 3
            },
            "client_compile_command": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 3
            }
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_variant", "server_variant", "case", "client_binary_sha256", "server_binary_sha256", "client_identity", "server_identity", "client_result_line", "server_done", "client_returncode", "outcome"],
        "properties": {
          "client_variant": { "type": "string", "enum": ["reference", "candidate"] },
          "server_variant": { "type": "string", "enum": ["reference", "candidate"] },
          "case": { "type": "string" },
          "client_binary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "server_binary_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "client_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exe_path", "exe_digest", "dsos", "loader_closure_digest"],
            "properties": {
              "exe_path": { "type": ["string", "null"] },
              "exe_digest": { "type": "string" },
              "dsos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": { "type": "string" },
                    "sha256": { "type": "string" }
                  }
                }
              },
              "loader_closure_digest": { "type": "string" }
            }
          },
          "server_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exe_path", "exe_digest", "dsos", "loader_closure_digest"],
            "properties": {
              "exe_path": { "type": ["string", "null"] },
              "exe_digest": { "type": "string" },
              "dsos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": { "type": "string" },
                    "sha256": { "type": "string" }
                  }
                }
              },
              "loader_closure_digest": { "type": "string" }
            }
          },
          "client_result_line": { "type": "string" },
          "server_done": { "type": "string" },
          "client_returncode": { "type": "integer" },
          "outcome": {
            "type": "string",
            "enum": ["pass", "fail", "reject", "not_run", "unresolved", "wrong_endpoint", "wrong_executable", "stale_fixture", "missing_cell", "missing_case", "duplicate_case", "substituted_dso"]
          }
        }
      },
      "minItems": 8,
      "maxItems": 8
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_cases", "total_cells", "common_failures", "candidate_specific_failures", "unresolved_cells", "mismatches"],
      "properties": {
        "total_cases": { "type": "integer", "minimum": 0 },
        "total_cells": { "type": "integer", "minimum": 0 },
        "common_failures": { "type": "array", "items": { "type": "string" } },
        "candidate_specific_failures": { "type": "array", "items": { "type": "string" } },
        "unresolved_cells": { "type": "array", "items": { "type": "string" } },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case", "client_variant", "server_variant", "expected", "observed"],
            "properties": {
              "case": { "type": "string" },
              "client_variant": { "type": "string", "enum": ["reference", "candidate"] },
              "server_variant": { "type": "string", "enum": ["reference", "candidate"] },
              "expected": { "type": "string" },
              "observed": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "refusal_code": {
      "type": ["string", "null"],
      "enum": [
        null, "not_run", "unresolved", "wrong_endpoint", "wrong_executable",
        "stale_fixture", "missing_cell", "missing_case", "duplicate_case",
        "substituted_dso"
      ]
    },
    "refusal_detail": { "type": "string" }
  }
}